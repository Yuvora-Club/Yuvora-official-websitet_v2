# Copy to .env for local overrides (see Backend/.env.example for PORT).
# Backend URL used by src/services/api.js (VITE_API_URL):
# Local dev:
VITE_API_URL=http://localhost:4000
# Production (Frontend/.env.production):
# VITE_API_URL=https://yuvora-backend.onrender.com
#
# Google "Continue with Google" (login + register pages):
# OAuth Client ID from Firebase Console (Authentication > Sign-in method >
# Google > enable, then expand the row to copy the Web client ID). Once set,
# the Google button appears on both auth pages. Leave empty to hide it.
VITE_GOOGLE_CLIENT_ID=