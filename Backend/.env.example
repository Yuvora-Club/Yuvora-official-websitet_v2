# Copy to .env and fill from Firebase Console > Project settings > Service accounts
# (Generate new private key). NEVER commit .env.

PORT=4000
# Comma-separated list of allowed browser origins (CORS). Must include the
# live domain or https://yuvora.org fetches fail preflight with
# "No 'Access-Control-Allow-Origin' header". Set the SAME value on Render:
# dashboard > service > Environment > FRONTEND_URL, then redeploy.
FRONTEND_URL=https://yuvora.org,https://www.yuvora.org,http://localhost:5173

FIREBASE_PROJECT_ID=yuvora-submission
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@yuvora-submission.iam.gserviceaccount.com
# Private key with \n escaped on one line (as it comes in the JSON key file):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# From your message — Realtime Database in asia-southeast1:
FIREBASE_DATABASE_URL=https://yuvora-submission-default-rtdb.asia-southeast1.firebasedatabase.app/
FIRESTORE_EMULATOR_HOST=
# Web API Key for password login + reset emails (POST /api/auth/login, /api/auth/reset).
# Firebase Console > Project settings > General > Your apps > Web API Key.
# Also add it on Render (dashboard > service > Environment). NOT the private key.
FIREBASE_WEB_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
